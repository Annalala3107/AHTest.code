# AHtest.code Production Environment Configuration

# 1. Supabase Authentication (Khuyên dùng - Quản lý Google OAuth & Session)
# Lấy tại Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://dcfehiahdpbfvyzekchr.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Google OAuth Client ID (Dành cho Google Identity Services direct)
# Lấy tại Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 3. Gemini API Key (Serverless Function /api/ai-mentor - KHÔNG dùng tiền tố VITE_)
# Lấy tại Google AI Studio -> API Keys và cấu hình trong Vercel Environment Variables
GEMINI_API_KEY=your-gemini-api-key
